<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Overlay trên cửa sổ hệ thống (Settings.canDrawOverlays). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Mạng. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service (Android 9+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      MEDIA_PROJECTION: Android không có uses-permission cùng tên.
      Quyền thực tế là người dùng chấp nhận MediaProjection intent + FGS type.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      ACCESSIBILITY_SERVICE: không phải uses-permission công khai.
      Hệ thống bind service qua android.permission.BIND_ACCESSIBILITY_SERVICE
      khi người dùng bật service trong Settings.
    -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIFacebookDetector"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AiFacebookDetectorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".FloatingWidgetService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".DetectorAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
